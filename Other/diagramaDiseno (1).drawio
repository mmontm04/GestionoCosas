<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/143.0.0.0 Safari/537.36" version="29.2.7">
  <diagram name="Página-1" id="mnKav1Di8CaVhPVLRXEu">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\n&#39; =========================\n&#39;  Layout / legibilidad\n&#39; =========================\ntop to bottom direction\nskinparam linetype ortho\nskinparam packageStyle rectangle\nskinparam shadowing false\nskinparam classAttributeIconSize 0\n\n&#39; =========================================================\n&#39;                  DISEÑO (sin entidades)\n&#39; =========================================================\n\npackage \&quot;Factories\&quot; {\n  interface IViewFactory {\n    +createLoginView(): LoginView\n    +createProductosListView(): ProductosListView\n    +createProductoFormView(): ProductoFormView\n    +createProductoItemView(): ProductoItemView\n\n    +createRecetasListView(): RecetasListView\n    +createRecetaDetalleView(): RecetaDetalleView\n    +createVentasPendientesView(): VentasPendientesView\n\n    +createRecetasGerenteListView(): RecetasGerenteListView\n    +createRecetaGerenteFormView(): RecetaGerenteFormView\n\n    +createUsuariosListView(): UsuariosListView\n    +createUsuarioFormView(): UsuarioFormView\n\n    +createPedidosListView(): PedidosListView\n    +createPedidoFormView(): PedidoFormView\n\n    +createInformesDashboardView(): InformesDashboardView\n  }\n\n  class ViewFactory &lt;&lt;Factory&gt;&gt; {\n    -theme: string\n    -locale: string\n    --\n    +createLoginView(): LoginView\n    +createProductosListView(): ProductosListView\n    +createProductoFormView(): ProductoFormView\n    +createProductoItemView(): ProductoItemView\n\n    +createRecetasListView(): RecetasListView\n    +createRecetaDetalleView(): RecetaDetalleView\n    +createVentasPendientesView(): VentasPendientesView\n\n    +createRecetasGerenteListView(): RecetasGerenteListView\n    +createRecetaGerenteFormView(): RecetaGerenteFormView\n\n    +createUsuariosListView(): UsuariosListView\n    +createUsuarioFormView(): UsuarioFormView\n\n    +createPedidosListView(): PedidosListView\n    +createPedidoFormView(): PedidoFormView\n\n    +createInformesDashboardView(): InformesDashboardView\n  }\n\n  IViewFactory &lt;|.. ViewFactory\n\n  interface IControllerFactory {\n    +createLoginController(): LoginController\n    +createCocineroController(): CocineroController\n    +createProductoController(): ProductoController\n    +createRecetasGerenteController(): RecetasGerenteController\n    +createUsuarioController(): UsuarioController\n    +createInformesController(): InformesController\n    +createPedidosController(): PedidosController\n  }\n\n  class ControllerFactory &lt;&lt;Factory&gt;&gt; {\n    -views: IViewFactory\n    -session: SessionController\n    -gerenteService: GerenteService\n    -cocineroService: CocineroService\n    -userDAO: IUserDAO\n    --\n    +createLoginController(): LoginController\n    +createCocineroController(): CocineroController\n    +createProductoController(): ProductoController\n    +createRecetasGerenteController(): RecetasGerenteController\n    +createUsuarioController(): UsuarioController\n    +createInformesController(): InformesController\n    +createPedidosController(): PedidosController\n  }\n\n  IControllerFactory &lt;|.. ControllerFactory\n}\n\npackage \&quot;UI\&quot; {\n  interface IView {\n    +render(model: any)\n    +showError(msg: string)\n  }\n\n  class LoginView &lt;&lt;View&gt;&gt; {\n    -usernameInput: string\n    -passwordInput: string\n    -errorMessage: string\n    --\n    +render(model: any)\n    +showError(msg: string)\n    +clear()\n  }\n\n  class ProductosListView &lt;&lt;View&gt;&gt; {\n    -renderer: IProductoView\n    -filtro: string\n    -soloStockBajo: bool\n    -selectedProductoId: int\n    --\n    +setRenderer(r: IProductoView)\n    +render(model: any)\n    +showError(msg: string)\n  }\n\n  class ProductoFormView &lt;&lt;View&gt;&gt; {\n    -modo: string\n    -validationErrors: string\n    --\n    +render(model: any)\n    +showError(msg: string)\n  }\n\n  class RecetasListView &lt;&lt;View&gt;&gt; {\n    -selectedRecetaId: int\n    --\n    +render(model: any)\n    +showError(msg: string)\n  }\n\n  class RecetaDetalleView &lt;&lt;View&gt;&gt; {\n    -selectedRecetaId: int\n    --\n    +render(model: any)\n    +showError(msg: string)\n  }\n\n  class VentasPendientesView &lt;&lt;View&gt;&gt; {\n    -selectedVentaId: int\n    --\n    +render(model: any)\n    +showError(msg: string)\n  }\n\n  class RecetasGerenteListView &lt;&lt;View&gt;&gt; {\n    -selectedRecetaId: int\n    --\n    +render(model: any)\n    +showError(msg: string)\n  }\n\n  class RecetaGerenteFormView &lt;&lt;View&gt;&gt; {\n    -modo: string\n    -validationErrors: string\n    --\n    +render(model: any)\n    +showError(msg: string)\n  }\n\n  class UsuariosListView &lt;&lt;View&gt;&gt; {\n    -selectedUsuarioId: int\n    --\n    +render(model: any)\n    +showError(msg: string)\n  }\n\n  class UsuarioFormView &lt;&lt;View&gt;&gt; {\n    -modo: string\n    -validationErrors: string\n    --\n    +render(model: any)\n    +showError(msg: string)\n  }\n\n  class PedidosListView &lt;&lt;View&gt;&gt; {\n    -selectedPedidoId: int\n    --\n    +render(model: any)\n    +showError(msg: string)\n  }\n\n  class PedidoFormView &lt;&lt;View&gt;&gt; {\n    -modo: string\n    -validationErrors: string\n    --\n    +render(model: any)\n    +showError(msg: string)\n  }\n\n  class InformesDashboardView &lt;&lt;View&gt;&gt; {\n    -selectedInformeId: int\n    -rangoInicio: Date\n    -rangoFin: Date\n    -tipoMovimiento: string\n    --\n    +render(model: any)\n    +showError(msg: string)\n  }\n\n  IView &lt;|.. LoginView\n  IView &lt;|.. ProductosListView\n  IView &lt;|.. ProductoFormView\n  IView &lt;|.. RecetasListView\n  IView &lt;|.. RecetaDetalleView\n  IView &lt;|.. VentasPendientesView\n  IView &lt;|.. RecetasGerenteListView\n  IView &lt;|.. RecetaGerenteFormView\n  IView &lt;|.. UsuariosListView\n  IView &lt;|.. UsuarioFormView\n  IView &lt;|.. PedidosListView\n  IView &lt;|.. PedidoFormView\n  IView &lt;|.. InformesDashboardView\n}\n\npackage \&quot;Controllers\&quot; {\n  interface IController {\n    +init()\n  }\n\n  class LoginController &lt;&lt;Controller&gt;&gt; {\n    -view: LoginView\n    -userDAO: IUserDAO\n    -session: SessionController\n    --\n    +init()\n    +showLogin()\n    +login(username: string, password: string)\n    +logout()\n  }\n\n  class CocineroController &lt;&lt;Controller&gt;&gt; {\n    -service: CocineroService\n    -recetasListView: RecetasListView\n    -recetaDetalleView: RecetaDetalleView\n    -ventasPendientesView: VentasPendientesView\n    --\n    +init()\n    +mostrarListaRecetas()\n    +mostrarRecetaDetallada(idReceta: int)\n    +mostrarVentasPendientes()\n    +confirmarProduccion(idVenta: int, cantidad: int)\n    +cambiarEstrategiaStock(tipo: string)\n  }\n\n  class ProductoController &lt;&lt;Controller&gt;&gt; {\n    -service: GerenteService\n    -listView: ProductosListView\n    -formView: ProductoFormView\n    --\n    +init()\n    +showLista(filtro: string, soloStockBajo: bool)\n    +showFormularioCrear()\n    +showFormularioEditar(idProducto: int)\n    +crear(dto: any)\n    +editar(dto: any)\n    +eliminar(idProducto: int)\n  }\n\n  class RecetasGerenteController &lt;&lt;Controller&gt;&gt; {\n    -service: GerenteService\n    -listView: RecetasGerenteListView\n    -formView: RecetaGerenteFormView\n    --\n    +init()\n    +showLista()\n    +showFormularioCrear()\n    +showFormularioEditar(idReceta: int)\n    +crear(dto: any)\n    +editar(dto: any)\n    +eliminar(idReceta: int)\n    +verDetalle(idReceta: int)\n  }\n\n  class UsuarioController &lt;&lt;Controller&gt;&gt; {\n    -service: GerenteService\n    -listView: UsuariosListView\n    -formView: UsuarioFormView\n    --\n    +init()\n    +showLista()\n    +showFormularioCrear()\n    +showFormularioEditar(idUsuario: int)\n    +crear(dto: any)\n    +editar(dto: any)\n    +eliminar(idUsuario: int)\n  }\n\n  class InformesController &lt;&lt;Controller&gt;&gt; {\n    -service: GerenteService\n    -view: InformesDashboardView\n    --\n    +init()\n    +showDashboard()\n    +generarInventario()\n    +generarMovimientos(desde: Date, hasta: Date, tipo: string)\n    +generarCostes(desde: Date, hasta: Date)\n    +exportarCSV(idInforme: int, ruta: string)\n    +exportarPDF(idInforme: int, ruta: string)\n  }\n\n  class PedidosController &lt;&lt;Controller&gt;&gt; {\n    -service: GerenteService\n    -listView: PedidosListView\n    -formView: PedidoFormView\n    --\n    +init()\n    +showLista()\n    +verDetalle(idPedido: int)\n    +showFormularioCrear()\n    +showFormularioEditar(idPedido: int)\n    +crear(dto: any)\n    +editar(dto: any)\n    +eliminar(idPedido: int)\n    +marcarRecibido(idPedido: int)\n  }\n\n  IController &lt;|.. LoginController\n  IController &lt;|.. CocineroController\n  IController &lt;|.. ProductoController\n  IController &lt;|.. RecetasGerenteController\n  IController &lt;|.. UsuarioController\n  IController &lt;|.. InformesController\n  IController &lt;|.. PedidosController\n}\n\npackage \&quot;Application / Services\&quot; {\n  class GerenteService &lt;&lt;Service&gt;&gt; {\n    -userDAO: IUserDAO\n    -productoDAO: IProductoDAO\n    -recetasDAO: IRecetasDAO\n    -pedidosDAO: IPedidosDAO\n    -informesDAO: IInformesDAO\n    -session: SessionController\n    -alerts: StockAlertManager\n    --\n    +crearProducto(dto: any)\n    +modificarProducto(dto: any)\n    +eliminarProducto(idProducto: int)\n    +listarProductos(filtro: string, soloStockBajo: bool)\n\n    +crearReceta(dto: any)\n    +modificarReceta(dto: any)\n    +eliminarReceta(idReceta: int)\n    +listarRecetas()\n    +verReceta(idReceta: int)\n\n    +crearUsuario(dto: any)\n    +modificarUsuario(dto: any)\n    +eliminarUsuario(idUsuario: int)\n    +listarUsuarios()\n\n    +crearPedido(dto: any)\n    +modificarPedido(dto: any)\n    +eliminarPedido(idPedido: int)\n    +listarPedidos()\n    +verPedido(idPedido: int)\n    +marcarPedidoRecibido(idPedido: int)\n\n    +generarInformeInventario()\n    +generarInformeMovimientos(desde: Date, hasta: Date, tipo: string)\n    +generarInformeCostes(desde: Date, hasta: Date)\n  }\n\n  class CocineroService &lt;&lt;Service&gt;&gt; {\n    -recetasDAO: IRecetasDAO\n    -productoDAO: IProductoDAO\n    -session: SessionController\n    -alerts: StockAlertManager\n    -stockStrategy: IStockStrategy\n    --\n    +listarRecetas()\n    +verReceta(idReceta: int)\n    +listarVentasPendientes()\n    +confirmarProduccion(idVenta: int, cantidad: int)\n    +setStockStrategy(strategy: IStockStrategy)\n  }\n}\n\npackage \&quot;Persistence / DAO\&quot; {\n  interface IUserDAO {\n    +findByUsername(username: string): any\n    +create(dto: any)\n    +update(dto: any)\n    +delete(id: int)\n  }\n\n  interface IProductoDAO {\n    +getAll(filtro: string): any\n    +create(dto: any)\n    +update(dto: any)\n    +delete(id: int)\n    +updateCantidad(id: int, cantidad: decimal)\n  }\n\n  interface IRecetasDAO {\n    +getAll(): any\n    +getById(id: int): any\n    +create(dto: any)\n    +update(dto: any)\n    +delete(id: int)\n  }\n\n  interface IInformesDAO {\n    +save(dto: any)\n    +getAll(): any\n    +getById(id: int): any\n  }\n\n  interface IPedidosDAO {\n    +getAll(): any\n    +getById(id: int): any\n    +create(dto: any)\n    +update(dto: any)\n    +delete(id: int)\n  }\n\n  class UserDAO &lt;&lt;DAO&gt;&gt; {\n    -db: DbConnection\n    --\n    +findByUsername(username: string): any\n    +create(dto: any)\n    +update(dto: any)\n    +delete(id: int)\n  }\n\n  class ProductoDAO &lt;&lt;DAO&gt;&gt; {\n    -db: DbConnection\n    --\n    +getAll(filtro: string): any\n    +create(dto: any)\n    +update(dto: any)\n    +delete(id: int)\n    +updateCantidad(id: int, cantidad: decimal)\n  }\n\n  class RecetasDAO &lt;&lt;DAO&gt;&gt; {\n    -db: DbConnection\n    --\n    +getAll(): any\n    +getById(id: int): any\n    +create(dto: any)\n    +update(dto: any)\n    +delete(id: int)\n  }\n\n  class InformesDAO &lt;&lt;DAO&gt;&gt; {\n    -db: DbConnection\n    --\n    +save(dto: any)\n    +getAll(): any\n    +getById(id: int): any\n  }\n\n  class PedidosDAO &lt;&lt;DAO&gt;&gt; {\n    -db: DbConnection\n    --\n    +getAll(): any\n    +getById(id: int): any\n    +create(dto: any)\n    +update(dto: any)\n    +delete(id: int)\n  }\n\n  IUserDAO &lt;|.. UserDAO\n  IProductoDAO &lt;|.. ProductoDAO\n  IRecetasDAO &lt;|.. RecetasDAO\n  IInformesDAO &lt;|.. InformesDAO\n  IPedidosDAO &lt;|.. PedidosDAO\n}\n\npackage \&quot;Infra / Cross-cutting\&quot; {\n  class SessionController &lt;&lt;Session&gt;&gt; {\n    -currentUserId: int\n    -currentRole: string\n    -lastActivity: Date\n    -timeoutMin: int\n    --\n    +startSession(userId: int, rol: string)\n    +endSession()\n    +isAuthenticated(): bool\n    +hasRole(rol: string): bool\n    +log(evento: LogEvento)\n  }\n\n  class LogEvento &lt;&lt;Log&gt;&gt; {\n    +timestamp: Date\n    +modulo: string\n    +accion: string\n    +resultado: string\n    +detalle: string\n  }\n\n  class DbConnection &lt;&lt;Singleton&gt;&gt; {\n    -connectionString: string\n    --\n    +getInstance()\n    +getConnection()\n    +testConnection(): bool\n  }\n\n  SessionController o-- \&quot;0..*\&quot; LogEvento\n}\n\npackage \&quot;Patterns: Observer (Stock bajo)\&quot; {\n  interface IStockObserver {\n    +onStockBajo(productoId: int, cantidad: decimal, minimo: decimal)\n  }\n\n  interface IStockSubject {\n    +attach(obs: IStockObserver)\n    +detach(obs: IStockObserver)\n    +notifyStockBajo(productoId: int, cantidad: decimal, minimo: decimal)\n  }\n\n  class StockAlertManager &lt;&lt;Subject&gt;&gt; {\n    -observers: List\n    -productoDAO: IProductoDAO\n    --\n    +attach(obs: IStockObserver)\n    +detach(obs: IStockObserver)\n    +notifyStockBajo(productoId: int, cantidad: decimal, minimo: decimal)\n    +checkStock(productoId: int)\n  }\n\n  class GerenteStockObserver &lt;&lt;Observer&gt;&gt; {\n    -session: SessionController\n    -productosListView: ProductosListView\n    --\n    +onStockBajo(productoId: int, cantidad: decimal, minimo: decimal)\n    +applyDecorator(view: ProductosListView)\n  }\n\n  IStockSubject &lt;|.. StockAlertManager\n  IStockObserver &lt;|.. GerenteStockObserver\n  StockAlertManager o-- \&quot;0..*\&quot; IStockObserver\n}\n\npackage \&quot;Patterns: Strategy (Cálculo stock)\&quot; {\n  interface IStockStrategy {\n    +calcular(productoId: int): decimal\n    +nombre(): string\n  }\n\n  class StockTeoricoStrategy\n  class StockRealStrategy\n  class StockTrasPedidoStrategy\n  class StockTrasVentaStrategy\n\n  IStockStrategy &lt;|.. StockTeoricoStrategy\n  IStockStrategy &lt;|.. StockRealStrategy\n  IStockStrategy &lt;|.. StockTrasPedidoStrategy\n  IStockStrategy &lt;|.. StockTrasVentaStrategy\n}\n\npackage \&quot;Patterns: Decorator (Producto en UI)\&quot; {\n  interface IProductoView {\n    +renderProducto(model: any)\n  }\n\n  class ProductoItemView &lt;&lt;View&gt;&gt; {\n    -normalStyle: string\n    --\n    +renderProducto(model: any)\n  }\n\n  class ProductoViewDecorator &lt;&lt;Decorator&gt;&gt; {\n    -wrapped: IProductoView\n    --\n    +ProductoViewDecorator(wrapped: IProductoView)\n    +renderProducto(model: any)\n  }\n\n  class ProductoStockBajoDecorator &lt;&lt;Decorator&gt;&gt; {\n    -highlightStyle: string\n    --\n    +ProductoStockBajoDecorator(wrapped: IProductoView)\n    +renderProducto(model: any)\n  }\n\n  IProductoView &lt;|.. ProductoItemView\n  IProductoView &lt;|.. ProductoViewDecorator\n  ProductoViewDecorator o-- IProductoView\n  ProductoViewDecorator &lt;|-- ProductoStockBajoDecorator\n}\n\n&#39; =========================================================\n&#39;                 Wiring / Dependencias\n&#39; =========================================================\n\n&#39; Factories wiring\nControllerFactory --&gt; IViewFactory\nControllerFactory --&gt; SessionController\nControllerFactory --&gt; GerenteService\nControllerFactory --&gt; CocineroService\nControllerFactory --&gt; IUserDAO\n\nViewFactory ..&gt; LoginView\nViewFactory ..&gt; ProductosListView\nViewFactory ..&gt; ProductoFormView\nViewFactory ..&gt; ProductoItemView\nViewFactory ..&gt; RecetasListView\nViewFactory ..&gt; RecetaDetalleView\nViewFactory ..&gt; VentasPendientesView\nViewFactory ..&gt; RecetasGerenteListView\nViewFactory ..&gt; RecetaGerenteFormView\nViewFactory ..&gt; UsuariosListView\nViewFactory ..&gt; UsuarioFormView\nViewFactory ..&gt; PedidosListView\nViewFactory ..&gt; PedidoFormView\nViewFactory ..&gt; InformesDashboardView\n\n&#39; Controllers -&gt; Views\nLoginController --&gt; LoginView\nCocineroController --&gt; RecetasListView\nCocineroController --&gt; RecetaDetalleView\nCocineroController --&gt; VentasPendientesView\nProductoController --&gt; ProductosListView\nProductoController --&gt; ProductoFormView\nRecetasGerenteController --&gt; RecetasGerenteListView\nRecetasGerenteController --&gt; RecetaGerenteFormView\nUsuarioController --&gt; UsuariosListView\nUsuarioController --&gt; UsuarioFormView\nPedidosController --&gt; PedidosListView\nPedidosController --&gt; PedidoFormView\nInformesController --&gt; InformesDashboardView\n\n&#39; Controllers -&gt; Services / Infra / DAO\nLoginController --&gt; SessionController\nLoginController --&gt; IUserDAO\n\nProductoController --&gt; GerenteService\nRecetasGerenteController --&gt; GerenteService\nUsuarioController --&gt; GerenteService\nPedidosController --&gt; GerenteService\nInformesController --&gt; GerenteService\nCocineroController --&gt; CocineroService\n\n&#39; Services -&gt; DAO + patterns\nGerenteService --&gt; IUserDAO\nGerenteService --&gt; IProductoDAO\nGerenteService --&gt; IRecetasDAO\nGerenteService --&gt; IPedidosDAO\nGerenteService --&gt; IInformesDAO\nGerenteService --&gt; SessionController\nGerenteService --&gt; StockAlertManager\n\nCocineroService --&gt; IRecetasDAO\nCocineroService --&gt; IProductoDAO\nCocineroService --&gt; SessionController\nCocineroService --&gt; IStockStrategy\nCocineroService --&gt; StockAlertManager\n\n&#39; Observer + Decorator\nStockAlertManager --&gt; GerenteStockObserver\nGerenteStockObserver --&gt; ProductosListView : setRenderer()\nGerenteStockObserver ..&gt; ProductoStockBajoDecorator : envuelve renderer\n\n&#39; ProductosListView usa renderer decorable\nProductosListView --&gt; IProductoView\nProductoItemView ..|&gt; IProductoView\n\n&#39; DAO -&gt; DB singleton\nUserDAO --&gt; DbConnection\nProductoDAO --&gt; DbConnection\nRecetasDAO --&gt; DbConnection\nInformesDAO --&gt; DbConnection\nPedidosDAO --&gt; DbConnection\n\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="2FppBfK9jxMrEbmPDNKO-10">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="2388" width="7212" x="-12320" y="-5530" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
